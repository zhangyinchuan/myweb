# ── Strapi Backend ────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=1337

# Strapi App Keys（生成方式：openssl rand -base64 32）
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=your_api_token_salt
ADMIN_JWT_SECRET=your_admin_jwt_secret
TRANSFER_TOKEN_SALT=your_transfer_token_salt
JWT_SECRET=your_jwt_secret

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=personal_website
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=your_db_password
DATABASE_SSL=false

# ── Aliyun OSS Media Storage ──────────────────────────────────────────────────
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your-bucket-name
OSS_REGION=oss-cn-hangzhou
OSS_BASE_URL=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com

# ── Next.js ISR Revalidation ──────────────────────────────────────────────────
NEXTJS_REVALIDATE_URL=http://localhost:3000
NEXTJS_REVALIDATE_TOKEN=your_revalidate_token_here
