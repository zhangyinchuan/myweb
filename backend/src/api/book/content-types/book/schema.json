{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "书籍推荐",
    "description": "书单推荐与读书笔记"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "author": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "publisher": {
      "type": "string",
      "maxLength": 255,
      "required": false
    },
    "publishedYear": {
      "type": "integer",
      "min": 1000,
      "max": 2100,
      "required": false
    },
    "isbn": {
      "type": "string",
      "maxLength": 20,
      "required": false
    },
    "shortReview": {
      "type": "text",
      "required": false
    },
    "notes": {
      "type": "blocks",
      "required": false
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "required": false
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "books"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "books"
    }
  }
}