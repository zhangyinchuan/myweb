# ── Next.js Frontend ─────────────────────────────────────────────────────────

# Strapi API base URL（服务器内网地址，不对外暴露）
STRAPI_URL=http://localhost:1337

# Strapi API Token（在 Strapi Admin → Settings → API Tokens 中创建 Read-only token）
STRAPI_API_TOKEN=your_strapi_api_token_here

# 前端站点公开 URL（用于 next/image remotePatterns 和 SEO）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ISR Revalidation Token（Strapi lifecycle 调用时需要，自定义随机字符串）
# 生成方式：openssl rand -hex 32
NEXTJS_REVALIDATE_TOKEN=your_revalidate_token_here
